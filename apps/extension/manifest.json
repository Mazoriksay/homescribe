{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.0.0",
  "default_locale": "en",
  "key": "",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://*.youtube.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["common.js", "background.js"]
  },
  "action": { "default_popup": "popup.html", "default_title": "Homescribe" },
  "web_accessible_resources": [{ "resources": ["pair.html"], "matches": ["<all_urls>"] }],
  "browser_specific_settings": {
    "gecko": { "id": "youtube-cookies@homescribe", "strict_min_version": "121.0" }
  }
}
