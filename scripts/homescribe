#!/usr/bin/env bash
# Start, stop and check Homescribe. The installer puts this next to
# compose.yaml and .env in the install folder.
#
#   ./homescribe start    start everything, wait until it answers, open the browser
#   ./homescribe stop     stop everything and free memory; data is kept
#   ./homescribe status   what is running, the address and the self-check
#   ./homescribe update   download newer files and images and restart

set -euo pipefail
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$SELF")"

case "${1:-}" in
  start|stop|status|update) ;;
  *) sed -n '2,9p' "$SELF" | sed 's/^# \{0,1\}//'; [ -z "${1:-}" ]; exit ;;
esac

if [ -t 1 ]; then
  GREEN=$'\033[32m'; RED=$'\033[31m'; RESET=$'\033[0m'
else
  GREEN=""; RED=""; RESET=""
fi
ok()  { printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
die() { printf '%s✗ %s%s\n' "$RED" "$*" "$RESET" >&2; exit 1; }

[ -f compose.yaml ] || die "No compose.yaml here. Run this from the Homescribe install folder."
command -v docker >/dev/null 2>&1 || die "Docker is not installed."

DOCKER="docker"
if ! docker info >/dev/null 2>&1; then
  if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && sudo docker info >/dev/null 2>&1; then
    DOCKER="sudo docker"  # this user is not in the docker group yet
  else
    die "Docker is not running. Start Docker (Docker Desktop on macOS) and try again."
  fi
fi

PORT="$(sed -n 's/^HOMESCRIBE_PORT=//p' .env 2>/dev/null | tail -1)"
PORT="${PORT:-8080}"
URL="http://localhost:$PORT"

health() { curl -fsS --max-time 5 "http://127.0.0.1:$PORT/api/v1/health" 2>/dev/null || true; }

checks() {
  local text
  text="$(health | sed -n 's/.*"checks":{\([^}]*\)}.*/\1/p' | tr -d '"' | tr ',' ' ')"
  echo "Self-check: ${text:-not available}"
}

# The self-check repeats every minute; right after start speaches may still load.
stt_note() {
  if ! health | grep -q '"stt":"ok"'; then
    echo "Speech recognition is still starting; new recordings wait in the queue until it is ready."
  fi
}

# Unpacks the browser extension next to this script; the settings show this
# folder (EXTENSION_FOLDER in .env) to paste into "Load unpacked".
update_extension() {
  local zip
  zip="$(mktemp)"
  if curl -fsS --max-time 30 "http://127.0.0.1:$PORT/api/v1/extension.zip" -o "$zip" 2>/dev/null; then
    mkdir -p browser-extension
    if command -v unzip >/dev/null 2>&1; then unzip -qo "$zip" -d browser-extension
    elif command -v python3 >/dev/null 2>&1; then python3 -m zipfile -e "$zip" browser-extension
    else echo "Install unzip to get the browser extension unpacked here."
    fi || echo "Could not unpack the browser extension."
  else
    echo "Could not download the browser extension."
  fi
  rm -f "$zip"
}

# What the installer sets for a GPU install, for installs made before it did:
# batched mode, and for a driver older than CUDA 12.9 the same speaches
# release built on an older CUDA. Values already in .env are kept.
gpu_defaults() {
  local cuda tag
  grep -qE '^COMPOSE_PROFILES=(.*,)?gpu(,|$)' .env 2>/dev/null || return 0
  # Batched speaches on the GPU takes long parts, as the installer sets it.
  if ! grep -q '^STT_BATCHED=' .env; then
    [ -z "$(tail -c 1 .env)" ] || echo >> .env
    echo "STT_BATCHED=true" >> .env
  fi
  grep -q '^SPEACHES_CUDA_IMAGE=' .env 2>/dev/null && return 0
  command -v nvidia-smi >/dev/null 2>&1 || return 0
  cuda="$(nvidia-smi 2>/dev/null | sed -n 's/.*CUDA Version: *\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -1)"
  [ -n "$cuda" ] || return 0
  tag="$(awk -v v="$cuda" 'BEGIN {
    split(v, p, "."); n = p[1] * 100 + p[2]
    if (n >= 1209) print ""; else if (n >= 1206) print "0.8.3-cuda-12.6.3"; else print "0.8.3-cuda-12.4.1"
  }')"
  [ -n "$tag" ] || return 0
  [ -z "$(tail -c 1 .env)" ] || echo >> .env
  echo "SPEACHES_CUDA_IMAGE=ghcr.io/speaches-ai/speaches:$tag" >> .env
  echo "The NVIDIA driver runs CUDA $cuda; speech recognition uses speaches $tag."
}

# compose.yaml and this script come from where the installer took them
# (HOMESCRIBE_FILES_URL in .env, empty for an install from a local checkout),
# so fixes in them reach existing installs too. A compose.yaml that Docker
# cannot read is not used.
refresh_files() {
  local base
  if grep -q '^HOMESCRIBE_FILES_URL=' .env 2>/dev/null; then
    base="$(sed -n 's/^HOMESCRIBE_FILES_URL=//p' .env | tail -1)"
  else
    base="https://raw.githubusercontent.com/mazoriksay/homescribe/main"
  fi
  [ -n "$base" ] || return 0
  if curl -fsSL --max-time 30 "$base/compose.yaml" -o compose.yaml.new \
    && $DOCKER compose -f compose.yaml.new config -q >/dev/null 2>&1; then
    mv compose.yaml.new compose.yaml
    ok "compose.yaml is up to date"
  else
    rm -f compose.yaml.new
    echo "Could not get a newer compose.yaml; keeping this one."
  fi
  gpu_defaults
  # A rename leaves the running copy of this script intact.
  if curl -fsSL --max-time 30 "$base/scripts/homescribe" -o homescribe.new && bash -n homescribe.new; then
    chmod +x homescribe.new
    mv homescribe.new "$SELF"
  else
    rm -f homescribe.new
  fi
}

wait_ready() {
  printf 'Waiting for Homescribe'
  local waited=0
  until [ -n "$(health)" ]; do
    [ "$waited" -ge 180 ] && { echo; die "Homescribe did not answer. Logs: $DOCKER compose logs homescribe"; }
    printf '.'; sleep 3; waited=$((waited + 3))
  done
  echo
}

open_browser() {
  if [ "$(uname -s)" = Darwin ]; then open "$URL" >/dev/null 2>&1 || true
  elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" >/dev/null 2>&1 || true
  fi
}

case "${1:-}" in
  start)
    $DOCKER compose up -d
    wait_ready
    update_extension
    ok "Homescribe is running: $URL"
    stt_note
    open_browser
    ;;
  stop)
    # down without -v: containers go, volumes with recordings and models stay.
    $DOCKER compose down
    ok "Homescribe is stopped and no longer uses memory."
    echo "Recordings, models and settings are kept. Start again with: $SELF start"
    ;;
  status)
    $DOCKER compose ps
    if [ -n "$(health)" ]; then
      ok "Homescribe answers at $URL"
      checks
    else
      echo "Homescribe is not running. Start it with: $SELF start"
    fi
    ;;
  update)
    refresh_files
    $DOCKER compose pull
    $DOCKER compose up -d --remove-orphans
    wait_ready
    update_extension
    ok "Updated and running: $URL"
    echo "To change models or the GPU/CPU choice, run the installer again."
    ;;
esac
